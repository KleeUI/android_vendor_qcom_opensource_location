cc_library_shared {
    name: "libloc_socket",
    defaults: ["qtilocationopensrc_common_defaults"],
    vendor: true,
    compile_multilib: "64",

    cflags: [
        "-fno-short-enums",
        "-D_ANDROID_",
    ] + GNSS_CFLAGS,

    srcs: ["LocSocket.cpp"],

    shared_libs: [
        "libutils",
        "libcutils",
        "liblog",
        "libgps.utils",
    ],

    header_libs: [
        "libloc_core_headers",
        "libgps.utils_headers",
        "libloc_pla_headers",
        "liblocation_api_headers",
        "klee_location_qmi_headers",
    ],

    export_include_dirs: ["."],
}
