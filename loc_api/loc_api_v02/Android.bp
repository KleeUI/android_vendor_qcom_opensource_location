
cc_library_shared {
    name: "libloc_api_v02",
    defaults: ["qtilocationopensrc_common_defaults"],
    vendor: true,
    compile_multilib: "64",

    cflags: [
        "-fno-short-enums",
        "-D_ANDROID_",
    ] + GNSS_CFLAGS,

    srcs: [
        "LocApiV02.cpp",
        "loc_api_v02_log.cpp",
        "loc_api_v02_client.cpp",
        "loc_api_sync_req.cpp",
        "location_service_v02.c",
    ],

    shared_libs: [
        "libutils",
        "libcutils",
        "//vendor/xiaomi/sm8450-common:libqmi_cci",
        "//vendor/xiaomi/sm8450-common:libqmi_common_so",
        "libloc_core",
        "libgps.utils",
        "libdl",
        "liblog",
    ],

    header_libs: [
        "libloc_core_headers",
        "libgps.utils_headers",
        "libloc_pla_headers",
        "liblocation_api_headers",
        "klee_location_qmi_headers",
    ],

    export_include_dirs: ["."],
}

cc_library_headers {

    name: "libloc_api_v02_headers",
    export_include_dirs: ["."],
    vendor: true,
}
